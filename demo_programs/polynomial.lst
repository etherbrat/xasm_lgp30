   1 ; polynomial.asm                         
   2 ; Evaluate polynomial                    
   3 ; LGP-30 Programming Manual, April 1957, 
   4 ; Page 19, 'Final Program', excluding ca 
   5 ;                                        
   6 ; Calcuate y = a0*x^4 + a1*x^3 + a2*x^2  
   7 ; Refactored as y = (((a0*x + a1)*x + a2 
   8 ;                                        
   9 .locn 1000                               locn = 1000
  10 start:                                   
  11     b add_instr ; initial add instr      
  12     c do_add    ; place inline and zero  
  13     h result    ; clear intermediate val 
  14 ;                                        
  15 loop:                                    
  16     b result    ; get intermediate value 
  17     m x         ; * x (initially 0)      
  18 do_add:                                  
  19     .word 0     ; indexed add instr for  
  20     h result    ; update intermediate va 
  21 ;                                        
  22     b do_add    ; get add instr          
  23     a CONST_1   ; increment address      
  24     h do_add    ; update add instr       
  25     s end_instr ; check for end of func  
  26     t loop      ; go back for more?      
  27     z 0         ; end of prog - temp con 
  28 ;                                        
  29 result:                                  
  30     .word 0     ; result accumulated her 
  31 CONST_1:                                 
  32     .atq 1 29   ; incrementer            
  33 add_instr:                               
  34     a a0        ; add instr with addr of 
  35 end_instr:                               
  36     a end_add   ; add instr with addr pa 
  37 ;                                        
  38 x:  .word 0     ; put x here using atqde 
  39 a0: .word 0     ; put a0 here using atqd 
  40 a1: .word 0     ; put a1 here - q value  
  41 a2: .word 0     ; put a2 here - a value  
  42 a3: .word 0     ; put a3 here - q value  
  43 a4: .word 0     ; put a4 here - q value  
  44 end_add: .word 0    ; past last constant 
  45 ;                                        
  46 .end start                               

