   1 ; echo.asm                               
   2 ; Echo characters received from the keyb 
   3 ; Set mode to 6-bit before running       
   4 ; Terminate each character with a stop c 
   5 ; Do NOT type more than one character be 
   6 ;                                        
   7 .locn 3737              ; any old locati locn = 3737
   8 ;                                        
   9 start:                                   
  10     c harmless          ; dump then clea 
  11     p 0                 ; start proceedi 
  12     i 0                 ; get input - 6  
  13     n shift2track       ; left shift bit 
  14     a pinstr            ; drop on a p in 
  15     h do_print          ; store the inst 
  16 do_print:                                
  17     .word 0             ; print          
  18     u start             ; loop           
  19 ;                                        
  20 shift2track:    .lshn 8 ; value to left  
  21 pinstr:         p 0     ; p instruction  
  22 harmless:       .word 0 ; some place to  
  23 ;                                        
  24 .end start                               

